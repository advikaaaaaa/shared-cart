# SharedCart local configuration (copy to .env if you need overrides)
SHAREDCART_ROOT=.
DATABASE_URL=sqlite:///./data/sharedcart.db
MODEL_PATH=models/model.pkl
MODEL_META_PATH=models/model_meta.json
DATA_DIR=data
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Set all three to private values to enable the admin console.
SHAREDCART_ADMIN_USERNAME=
SHAREDCART_ADMIN_PASSWORD=
# Generate a unique random secret of at least 32 characters; never commit real credentials.
SHAREDCART_ADMIN_SECRET=
# Set true only when serving over HTTPS.
SHAREDCART_COOKIE_SECURE=false
